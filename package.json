{
  "name": "magkahiusa-talibon",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:api": "pnpm --filter @magkahiusa/api dev",
    "dev:municipal": "pnpm --filter @magkahiusa/municipal-web dev",
    "dev:barangay": "pnpm --filter @magkahiusa/barangay-pwa dev",
    "dev:public": "pnpm --filter @magkahiusa/public-web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "db:generate": "pnpm --filter @magkahiusa/api db:generate",
    "db:migrate": "pnpm --filter @magkahiusa/api db:migrate"
  },
  "devDependencies": {
    "prisma": "5.22.0"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "zod": "^3.24.2"
  }
}
